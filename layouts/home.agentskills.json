{{- /*
  Agent Skills discovery index (https://github.com/cloudflare/agent-skills-discovery-rfc)
  at /.well-known/agent-skills/index.json. It lists one skill that tells agents
  how to read, search, and cite this site. The skill is rendered from
  assets/agent-skills/SKILL.md and its SHA-256 digest is computed from the
  published bytes, so the index always matches the file.
*/ -}}
{{- $skill := partial "discovery/skill.html" . -}}
{{- $index := dict
  "$schema" "https://schemas.agentskills.io/discovery/0.2.0/schema.json"
  "skills" (slice (dict
    "name" $skill.name
    "type" "skill-md"
    "description" $skill.description
    "url" $skill.resource.Permalink
    "digest" (printf "sha256:%s" (crypto.SHA256 $skill.resource.Content))
  ))
-}}
{{- $index | jsonify (dict "indent" "  ") -}}
