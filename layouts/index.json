{{- $main := site.Params.mainSections | default (slice "posts") -}}
{{- $sections := cond (reflect.IsSlice $main) $main (slice $main) -}}
{{- $searchPages := where site.RegularPages "Type" "page" -}}
{{- $searchPosts := where site.RegularPages "Section" "in" $sections -}}
{{- $index := slice -}}
{{- range (union $searchPages $searchPosts) -}}
    {{- $index = $index | append (dict "title" .Title "tags" .Params.tags "categories" .Params.categories "contents" (.Plain | truncate 500) "permalink" .RelPermalink "date" .Date "kind" (cond (eq .Type "page") "page" "post")) -}}
{{- end -}}
{{- $index | jsonify -}}
